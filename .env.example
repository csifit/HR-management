NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use your exact Vercel production URL after deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=HRConnector

# Optional transactional email through your MXroute account. Never use NEXT_PUBLIC_ for credentials.
# Copy the server hostname from MXroute's control panel; it may differ from mkdir.space.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=admin@mkdir.space
SMTP_PASSWORD=
SMTP_FROM=admin@mkdir.space
